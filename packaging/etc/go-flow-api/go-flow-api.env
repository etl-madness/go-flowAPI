# ==============================================================================
# ETL Madness go-flowAPI — Daemon Environment Configuration
# ==============================================================================
# Restrict file permissions after adding credentials:
#   chmod 0640 /etc/go-flow-api/go-flow-api.env
#   chown root:flowapi /etc/go-flow-api/go-flow-api.env
#
# IMPORTANT: go-flowAPI does NOT auto-create tables at startup.
# Provision your database schema first using:
#   /opt/flow-api/share/doc/SCHEMA.md
#   /opt/flow-api/share/sql/{sqlite-init.sql,postgres-init.sql,sqlserver-init.sql}
# ==============================================================================

# HTTP listen address (e.g., ":8080", ":5180", or "127.0.0.1:8080" behind a reverse proxy)
FLOW_API_ADDR=":8080"

# Primary startup database connection string (5 dialects supported):
#   SQLite:     FLOW_API_DSN="sqlite:///var/lib/go-flow-api/flow_api.db"
#   SQL Server: FLOW_API_DSN="sqlserver://flow_api:StrongPass!@db.example.com:1433?database=FLOW_DB&trustServerCertificate=true"
#   PostgreSQL: FLOW_API_DSN="postgres://flow_api:StrongPass!@db.example.com:5432/flow_db?sslmode=require"
#   MySQL:      FLOW_API_DSN="mysql://flow_api:StrongPass!@tcp(db.example.com:3306)/flow_db?parseTime=true"
#   Oracle:     FLOW_API_DSN="oracle://flow_api:StrongPass!@db.example.com:1521/FREEPDB1"
FLOW_API_DSN="sqlite:///var/lib/go-flow-api/flow_api.db"

# Default AES-256-GCM passphrase for encrypted pipeline/options/config artifacts (optional)
# FLOW_SECURE_KEY=""

# Optional root directory for per-job <user_login>/<pid>-<run_id> sandboxed workspaces (-data-dir)
# When set, all script working directories and relative file inputs/outputs are confined to the job directory
# and cleaned up automatically when the job finishes.
# FLOW_API_DATA_DIR="/var/lib/go-flow-api/jobs"

# Optional JSON/YAML mapping file to override database schema and table names (-tables-config)
# FLOW_TABLES_CONFIG="/etc/go-flow-api/tables.json"

# Enable verbose debug logging (true | false)
FLOW_API_DEBUG="false"

# Enforce strict ACL-only pipeline authorization so non-admin accounts require explicit ACLs (default: true)
FLOW_API_STRICT_ACL="true"

# Optional one-time initial administrator user bootstrap (remove after initial startup)
# FLOW_API_BOOTSTRAP_USER="admin"
# FLOW_API_BOOTSTRAP_PASS="ChangeMe!StrongPass123"
# FLOW_API_BOOTSTRAP_PERM="all"

# Optional Active Directory / Kerberos SQL Server Integrated Auth on Linux/macOS/FreeBSD:
# AD_REALM="EXAMPLE.COM"
# KRB5_CONFIG="/etc/krb5.conf"
# KRB5_KTNAME="/etc/go-flow-api/flowapi.keytab"
# KRB5CCNAME="/run/go-flow-api/krb5cc"
